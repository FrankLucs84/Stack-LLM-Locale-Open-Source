# =========================================================
#  Stack LLM Locale — .env.example
#  Copia questo file in .env e compila i valori.
#  NON committare mai il .env reale (è nel .gitignore).
# =========================================================

# ---- OLLAMA (L1) ----
# Endpoint locale del runtime. Default standard.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- ANYTHINGLLM (L3 RAG) ----
ANYTHINGLLM_PORT=3001
# Se usi Docker, l'URL Ollama diventa host.docker.internal:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- OPENWORKER (L3 Agente, opzionale) ----
OPENWORKER_HOST=127.0.0.1
OPENWORKER_PORT=8765
OPENWORKER_MODEL=ollama:qwen3-coder:8b
OPENWORKER_MODE=interactive

# ---- CHIAVI CLOUD (SOLO se usi endpoint pubblici — sconsigliato per dati riservati) ----
# Lasciare vuoto per setup 100% locale.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- NOTA COMPLIANCE ----
# Per dati riservati / EU AI Act: usare SOLO modelli locali (Ollama).
# Non popolare le chiavi cloud sopra se il materiale è sensibile.
